# Entra ID tenant id (GUID) or 'common'/'organizations'.
AAD_TENANT_ID=common

# Application (client) id of the SERVER Entra ID app registration.
AAD_SERVER_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Comma-separated list of app roles the caller must hold (any one). Leave empty
# to skip the role check.
AAD_REQUIRED_APP_ROLES=Api.Access

# Only needed if the server performs the On-Behalf-Of flow to call downstream
# APIs. Not required for plain token validation.
AAD_SERVER_CLIENT_SECRET=
